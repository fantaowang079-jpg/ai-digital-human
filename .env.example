# ===== LLM 配置 =====
# mock（无需 key，先跑通全链路）| deepseek（真实对话）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== TTS 配置 =====
TTS_PROVIDER=edge
# 中文音色：zh-CN-XiaoxiaoNeural(女) / zh-CN-YunxiNeural(男)
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===== STT 配置 =====
# 首次识别会从 hf-mirror 下载模型（base 约 150MB），之后复用本地缓存
STT_PROVIDER=faster-whisper
# tiny / base / small / medium / large
STT_MODEL_SIZE=base

# ===== 两种模式的人格设定（可选，留空使用内置默认）=====
# 专业模式「知语」：严格依据知识库回答，并标注引用来源
PROFESSIONAL_PROMPT=
# 心理医生模式「心语」：共情闲聊，不检索知识库
PSYCHOLOGIST_PROMPT=
# 通用补充要求（两种模式都会追加，可为空）
SYSTEM_PROMPT=用简洁、口语化的中文回答。

# ===== 知识库（RAG-lite）=====
# 上传的文档和手工放入的文档都保存在该目录，默认 knowledge/
KB_ENABLED=true
KB_DIR=
# 每次检索注入的片段数（专业模式至少取 6 段）
KB_TOP_K=4
# 相关度阈值（0~1），低于该值视为未命中
KB_MIN_SCORE=0.05
# 注入 system prompt 的上下文最大字符数（专业模式至少 4000）
KB_MAX_CONTEXT_CHARS=3000

# ===== 上下文记忆 =====
# 本地 SQLite 记忆库，保存对话历史和自动摘要，刷新/重启后仍可回顾
MEMORY_ENABLED=true
# 留空默认项目根目录 data/memory.db
MEMORY_DB_PATH=
# 最近多少条消息原样保留在提示词里
MEMORY_KEEP_VERBATIM=12
# 未摘要的旧消息攒够多少条后自动压缩成摘要
MEMORY_SUMMARIZE_AFTER=12
