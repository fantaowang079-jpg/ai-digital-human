# ===== LLM 配置 =====
# mock（无需 key，先跑通全链路）| deepseek（真实对话）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== TTS 配置 =====
TTS_PROVIDER=edge
# 中文音色：zh-CN-XiaoxiaoNeural(女) / zh-CN-YunxiNeural(男)
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===== STT 配置 =====
# 首次识别会从 hf-mirror 下载模型（base 约 150MB），之后复用本地缓存
STT_PROVIDER=faster-whisper
# tiny / base / small / medium / large
STT_MODEL_SIZE=base

# ===== 数字人角色设定（system prompt）=====
SYSTEM_PROMPT=你是「小助手」，一个友好的 AI 数字人。用简洁、口语化的中文回答用户，每次回复控制在 3 句话以内。

# ===== 知识库（RAG-lite）=====
# 上传的文档和手工放入的文档都保存在该目录，默认 knowledge/
KB_ENABLED=true
KB_DIR=
# 每次检索注入的片段数
KB_TOP_K=4
# 相关度阈值（0~1），低于该值视为未命中
KB_MIN_SCORE=0.05
# true：没有命中资料时，要求模型明确回答「知识库中没有找到相关信息」
KB_STRICT=false
# 注入 system prompt 的上下文最大字符数
KB_MAX_CONTEXT_CHARS=3000
