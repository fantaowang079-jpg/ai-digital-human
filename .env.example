# ===== LLM 配置 =====
# mock（无需 key，先跑通全链路）| deepseek（真实对话）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== TTS 配置 =====
TTS_PROVIDER=edge
# 中文音色：zh-CN-XiaoxiaoNeural(女) / zh-CN-YunxiNeural(男)
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===== STT 配置 =====
# 首次识别会从 hf-mirror 下载模型（base 约 150MB），之后复用本地缓存
STT_PROVIDER=faster-whisper
# tiny / base / small / medium / large
STT_MODEL_SIZE=base
# 中文识别参数（不填则用默认值）
STT_LANGUAGE=zh
STT_BEAM_SIZE=5
STT_INITIAL_PROMPT=以下是普通话的句子，请用简体中文输出。

# ===== 语音输入（VAD）配置 =====
# 音量阈值（RMS），越小越灵敏
VAD_THRESHOLD=0.02
# 判定时间条：说话后停顿多久开始识别（毫秒），以及前端可调范围
VAD_SILENCE_MS=2000
VAD_SILENCE_MS_MIN=1000
VAD_SILENCE_MS_MAX=4000
# 单次录音最长时长 / 一直不说话的超时（毫秒）
VAD_MAX_RECORD_MS=15000
VAD_IDLE_TIMEOUT_MS=12000

# ===== 打断（barge-in）=====
# 数字人说话时监听人声；超过阈值并累计一段时间就停止播报
# 实际阈值会按现场底噪自适应上调（最高 2.5 倍），避免被扬声器回声误触发
# 觉得太灵敏/不灵敏时优先调这里：0.02 很灵敏，0.05 以上较保守
BARGE_IN_THRESHOLD=0.03
BARGE_IN_HOLD_MS=300
# 开始播报后的静默期（毫秒），避开起播杂音
BARGE_IN_GUARD_MS=400

# ===== 数字人角色设定（system prompt）=====
SYSTEM_PROMPT=你是「小助手」，一个友好的 AI 数字人。用简洁、口语化的中文回答用户，每次回复控制在 3 句话以内。
